{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/google0f508b164a828c08.html",
      "destination": "/api/google-verify?id=0f508b164a828c08"
    },
    {
      "source": "/google:id.html",
      "destination": "/api/google-verify?id=:id"
    },
    {
      "source": "/webhooks",
      "destination": "/api/webhooks"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "/api/webhooks/:path*"
    }
  ],
  "functions": {
    "pages/api/**/*": {
      "maxDuration": 60
    },
    "pages/api/**/*.js": {
      "maxDuration": 60
    },
    "pages/api/agent/execute.js": {
      "maxDuration": 60
    },
    "pages/api/gmb/auto-reply.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/gmb/auto-reply",
      "schedule": "0 0 * * *"
    }
  ]
}
